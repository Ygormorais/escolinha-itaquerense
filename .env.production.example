# =============================================================
# .env de PRODUÇÃO — Escolinha Itaquerense
# Copie para .env na VPS:  cp .env.production.example .env
# Gere os segredos com:    bash deploy/gen-secrets.sh
# Checklist completo:      deploy/README.md (seção 3)
# =============================================================

# --- Banco (SQLite local na VPS; caminho relativo ao repo) ---
DATABASE_URL=file:./prisma/prod.db

# --- Uploads (fotos e documentos fora de public/ para auth obrigatória) ---
# Deixe vazio para usar o padrão: <raiz-do-repo>/uploads
UPLOADS_DIR=

# --- App ---
# URL pública real (com https:// quando houver domínio)
NEXT_PUBLIC_APP_URL=https://SEU_DOMINIO

# --- Login do painel admin ---
ADMIN_USERNAME=admin
# gere com gen-secrets.sh — NUNCA usar admin/escolinha123 em produção
ADMIN_PASSWORD=

# --- Segredos internos (gere com gen-secrets.sh) ---
SESSION_SECRET=
CRON_SECRET=
FPFS_SYNC_TOKEN=

# --- Mercado Pago ---
# Sandbox: TEST-...  |  Produção: APP_USR-... (só após homologação)
MERCADOPAGO_ACCESS_TOKEN=
# Painel MP > Webhooks, apontando para NEXT_PUBLIC_APP_URL/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=

# --- Push notifications (gere com gen-secrets.sh) ---
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# formato mailto:
VAPID_EMAIL=mailto:contato@SEU_DOMINIO

# --- Chatbot WhatsApp (opcional — só se o bot for ao ar) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ANTHROPIC_API_KEY=
# modelo do chatbot (default no código se vazio)
CLAUDE_MODEL=

# --- E-mail (recuperação de senha do portal responsável) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Endereço real do clube (carteirinha / documentos) ---
ESCOLA_LOGRADOURO=
ESCOLA_NUMERO=
ESCOLA_BAIRRO=
ESCOLA_CIDADE=
ESCOLA_UF=SP
ESCOLA_CEP=

# --- Google (integração planilha/agenda, se usada) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# chave privada do service account entre aspas, com \n literais
GOOGLE_PRIVATE_KEY=
