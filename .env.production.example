# =============================================================
# .env de PRODUÇÃO — Escolinha Itaquerense
# Copie para .env na VPS:  cp .env.production.example .env
# Gere os segredos com:    bash deploy/gen-secrets.sh
# Checklist completo:      deploy/README.md (seção 3)
# =============================================================

# --- Banco (SQLite local na VPS; volume persistente fora do repositório) ---
DATABASE_URL=file:/var/lib/escolinha/prod.db

# --- Uploads (fotos e documentos fora de public/ para auth obrigatória) ---
# Volume persistente, fora do repositório e de public/. O setup-vps.sh cria a pasta.
UPLOADS_DIR=/var/lib/escolinha/uploads

# Configurações editáveis do clube também precisam sobreviver a novos deploys.
CLUB_CONFIG_PATH=/var/lib/escolinha/config/club.config.json

# Backups locais atômicos do SQLite. A cópia externa é configurada no runbook.
BACKUP_DIR=/var/lib/escolinha/backups
BACKUP_RETENTION_COUNT=30
# Defina true no lançamento completo para falhar o deploy sem SMTP, WhatsApp,
# Google Calendar e todas as credenciais de push/pagamentos.
REQUIRE_OPTIONAL_INTEGRATIONS=false

# Datas de nascimento e vencimento são persistidas/interpretadas em UTC.
TZ=UTC

# --- App ---
# URL pública real (com https:// quando houver domínio)
NEXT_PUBLIC_APP_URL=https://SEU_DOMINIO

# --- Login do painel admin ---
ADMIN_USERNAME=admin
# gere com gen-secrets.sh — NUNCA usar admin/escolinha123 em produção
ADMIN_PASSWORD=
# Só use true numa rotação deliberada; o default preserva a senha já cadastrada.
ADMIN_SEED_FORCE_UPDATE=false

# --- Segredos internos (gere com gen-secrets.sh) ---
SESSION_SECRET=
CRON_SECRET=
FPFS_SYNC_TOKEN=

# --- Mercado Pago ---
# Sandbox: TEST-...  |  Produção: APP_USR-... (só após homologação)
MERCADOPAGO_ACCESS_TOKEN=
# Painel MP > Webhooks, apontando para NEXT_PUBLIC_APP_URL/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=

# --- Push notifications (gere com gen-secrets.sh) ---
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# formato mailto:
VAPID_EMAIL=mailto:contato@SEU_DOMINIO

# --- Chatbot WhatsApp (opcional — só se o bot for ao ar) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ANTHROPIC_API_KEY=
# modelo do chatbot (default no código se vazio)
CLAUDE_MODEL=

# --- E-mail (recuperação de senha do portal responsável) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Endereço real do clube (carteirinha / documentos) ---
ESCOLA_LOGRADOURO=
ESCOLA_NUMERO=
ESCOLA_BAIRRO=
ESCOLA_CIDADE=
ESCOLA_UF=SP
ESCOLA_CEP=

# --- Google (integração planilha/agenda, se usada) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# chave privada do service account entre aspas, com \n literais
GOOGLE_PRIVATE_KEY=
