{
  "name": "escolinha-itaquerense",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-prod": "npx tsx prisma/seed-prod.ts",
    "db:seed-demo": "npx tsx prisma/seed-demo.ts",
    "db:studio": "npx prisma studio",
    "db:check": "npx tsx scripts/check-pre-deploy.ts",
    "deploy:check": "npx tsx scripts/check-deploy.ts",
    "db:backup": "npx tsx scripts/backup.ts",
    "db:restore": "npx tsx scripts/restore.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "housekeeping": "npx tsx scripts/housekeeping.ts",
    "fpfs:sync": "npx tsx scripts/fpfs-sync-once.ts",
    "fpfs:setup": "npx tsx scripts/setup-fpfs-sync.ts",
    "fpfs:install-cron": "powershell -ExecutionPolicy Bypass -File scripts/install-fpfs-cron.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "googleapis": "^172.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.16.0",
    "mercadopago": "^3.1.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.21.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "nanoid": "3.3.18"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "better-sqlite3@12.10.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
