generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Aluno {
  id             Int                   @id @default(autoincrement())
  nome           String
  dataNascimento DateTime
  turma          String
  horario        String
  responsavel    String
  telefone       String
  email          String
  dataMatricula  DateTime
  mensalidade    Float
  desconto       Float                 @default(0)
  foto           String?
  posicao        String?               // GOLEIRO | FIXO | ALA_ESQ | ALA_DIR | PIVO
  status         String                @default("Ativo")
  observacoes    String?
  // Ficha médica
  tipoSanguineo  String?
  alergias       String?
  condicaoSaude  String?
  contatoEmergenciaNome     String?
  contatoEmergenciaTel      String?
  contatoEmergenciaParentesco String?
  pagamentos     Pagamento[]
  frequencias    Frequencia[]
  uniformes      Uniforme[]
  whatsapp       WhatsAppMensagem[]
  transacoes     TransacaoMaquina[]
  inscricoes     InscricaoCampeonato[]
  responsavelId  Int?
  responsavelRef Responsavel?          @relation(fields: [responsavelId], references: [id])
  avaliacoes     Avaliacao[]
  escalacoes     EscalacaoJogador[]
  acoesDesenvolvimento AcaoDesenvolvimento[]
  resumosFamiliares ResumoFamiliar[]
  sessoesTreino SessaoTreinoAtleta[]
  disponibilidadesPartida DisponibilidadePartida[]
  disponibilidadesEvento DisponibilidadeEvento[]
  objetivosCompartilhados ObjetivoCompartilhado[]
  aceitesDocumentos DocumentoAceite[]
  leiturasFichaMedica FichaMedicaLeitura[]
  conversasFamilia ConversaFamilia[]
  fichaMedicaVersao Int @default(1)
  renovacoes     RenovacaoMatricula[]
  createdAt      DateTime              @default(now())

  @@index([status])
  @@index([turma])
  @@index([responsavelId])
}

model Pagamento {
  id             Int                @id @default(autoincrement())
  alunoId        Int
  aluno          Aluno              @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  mesReferencia  String
  dataVencimento DateTime
  dataPagamento  DateTime?
  formaPagamento String?
  valorRecebido  Float?
  observacoes    String?
  transacoes     TransacaoMaquina[]
  canalPrevisto  String?
  statusCobranca String?
  externalId     String?
  linhaDigitavel String?
  pixCopiaECola  String?
  externalUrl    String?
  createdAt      DateTime           @default(now())

  @@unique([alunoId, mesReferencia])
  @@index([alunoId])
  @@index([mesReferencia])
  @@index([dataPagamento])
  @@index([mesReferencia, dataPagamento])
  @@index([dataPagamento, dataVencimento])
  @@index([statusCobranca])
  @@index([externalId])
}

model Custo {
  id             Int      @id @default(autoincrement())
  data           DateTime
  categoria      String
  descricao      String
  fornecedor     String
  valor          Float
  formaPagamento String
  comprovante    Boolean  @default(false)
  observacoes    String?
  createdAt      DateTime @default(now())

  @@index([data])
  @@index([categoria])
}

model CustoRecorrente {
  id             Int      @id @default(autoincrement())
  categoria      String
  descricao      String
  fornecedor     String
  valor          Float
  formaPagamento String
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Frequencia {
  id       Int      @id @default(autoincrement())
  alunoId  Int
  aluno    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  data     DateTime
  presenca String

  @@unique([alunoId, data])
  @@index([data])
}

model Uniforme {
  id          Int       @id @default(autoincrement())
  alunoId     Int
  aluno       Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  item        String
  tamanho     String?
  entregue    Boolean   @default(false)
  dataEntrega DateTime?
  observacoes String?
  createdAt   DateTime  @default(now())

  @@index([alunoId])
}

model Log {
  id        Int      @id @default(autoincrement())
  tipo      String
  descricao String
  usuario   String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([tipo])
  @@index([createdAt])
}

model Responsavel {
  id                Int                     @id @default(autoincrement())
  nome              String
  email             String                  @unique
  telefone          String
  senha             String
  cpf               String?                 @unique
  ativo             Boolean                 @default(true)
  alunos            Aluno[]
  chatSessions      ChatSession[]
  resetTokens       ResetToken[]
  solicitacoes      Solicitacao[]
  renovacoes        RenovacaoMatricula[]
  pushSubscriptions PushSubscription[]
  notificacaoPrefs  NotificacaoPreferencia?
  resumosPublicados PublicacaoResumo[]
  disponibilidadesPartida DisponibilidadePartida[]
  disponibilidadesEvento DisponibilidadeEvento[]
  aceitesDocumentos DocumentoAceite[]
  createdAt         DateTime                @default(now())
}

model ResetToken {
  id            Int         @id @default(autoincrement())
  token         String      @unique
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id])
  usado         Boolean     @default(false)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([responsavelId])
  @@index([expiresAt])
}

model Evento {
  id         Int      @id @default(autoincrement())
  titulo     String
  tipo       String // Treino, Jogo, Evento, Reunião
  data       DateTime
  horaInicio String?
  horaFim    String?
  local      String?
  turmas     String? // "Todas" ou turmas separadas por vírgula
  descricao  String?
  status     String   @default("pendente") // pendente, confirmado, cancelado, realizado
  createdAt  DateTime @default(now())
  disponibilidades DisponibilidadeEvento[]

  @@index([data])
  @@index([status])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  nome      String
  senha     String
  role      String   @default("secretaria") // admin, secretaria, tecnico
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  acoesResponsavel AcaoDesenvolvimento[] @relation("ResponsavelAcaoDesenvolvimento")
  notificacoesInternas NotificacaoInterna[]
  notificacoesInternasAtivas Boolean @default(true)
  atividadesFavoritas AtividadeTreinoFavorito[]
  rotinasResponsavel RotinaOperacional[] @relation("ResponsavelRotinaOperacional")
  ocorrenciasRotinaConcluidas RotinaOcorrencia[] @relation("ConclusaoRotinaOperacional")
  leiturasFichaMedica FichaMedicaLeitura[]
  regrasAutomacao RegraAutomacao[] @relation("ResponsavelRegraAutomacao")
}

model Recibo {
  id             Int      @id @default(autoincrement())
  numero         String   @unique
  codigoVerificacao String? @unique
  hashIntegridade String?
  alunoNome      String
  responsavel    String
  mesReferencia  String
  valor          Float
  formaPagamento String
  dataPagamento  DateTime
  emitidoPor     String?
  canceladoAt    DateTime?
  canceladoPor   String?
  createdAt      DateTime @default(now())
}

model Campeonato {
  id                Int                   @id @default(autoincrement())
  nome              String
  descricao         String?
  dataInicio        DateTime
  dataFim           DateTime?
  local             String?
  taxaInscricao     Float                 @default(0)
  taxaJogo          Float                 @default(0) // taxa por jogo/rodada
  taxaArbitragem    Float                 @default(0)
  custoTransporte   Float                 @default(0)
  custoUniforme     Float                 @default(0)
  observacoes       String?
  status            String                @default("aberto") // aberto, andamento, encerrado
  fpfsEventoId      Int? // id do evento na FPFS (ex.: 920)
  fpfsTimeNome      String? // nome do nosso time como aparece na FPFS
  fpfsSyncEm        DateTime? // ultimo sync bem-sucedido
  inscricoes        InscricaoCampeonato[]
  partidas          Partida[]
  media             Media[]
  classificacaoFpfs ClassificacaoFpfs[]
  createdAt         DateTime              @default(now())
}

model Partida {
  id           Int                @id @default(autoincrement())
  campeonatoId Int
  campeonato   Campeonato         @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  rodada       Int                @default(1)
  data         DateTime
  adversario   String
  /** URL do escudo do adversário (FPFS admfutsal) */
  adversarioEscudoUrl String?
  local        String             @default("Casa") // Casa, Fora, Neutro
  golsPro      Int?
  golsContra   Int?
  resultado    String? // Vitoria, Derrota, Empate — null se não realizada
  observacoes  String?
  fpfsJogoId   String? // id do jogo na FPFS (link da sumula)
  sumulaUrl    String? // URL da sumula
  media        Media[]
  escalacao    EscalacaoJogador[]
  disponibilidades DisponibilidadePartida[]
  createdAt    DateTime           @default(now())

  @@unique([campeonatoId, fpfsJogoId])
  @@index([campeonatoId])
  @@index([data])
}

model ClassificacaoFpfs {
  id           Int        @id @default(autoincrement())
  campeonatoId Int
  campeonato   Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  fase         String
  grupo        String?
  posicao      Int
  timeNome     String
  pontos       Int        @default(0)
  jogos        Int        @default(0)
  vitorias     Int        @default(0)
  empates      Int        @default(0)
  derrotas     Int        @default(0)
  golsPro      Int        @default(0)
  golsContra   Int        @default(0)
  saldo        Int        @default(0)
  ehNosso      Boolean    @default(false)
  atualizadoEm DateTime   @default(now())

  @@index([campeonatoId])
}

model InscricaoCampeonato {
  id             Int        @id @default(autoincrement())
  campeonatoId   Int
  campeonato     Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  alunoId        Int
  aluno          Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  bolsa          Boolean    @default(false) // bolsa integral (isento)
  desconto       Float      @default(0) // desconto em R$ sobre a taxa total
  taxaPaga       Boolean    @default(false)
  valorPago      Float? // valor efetivamente pago
  dataPagamento  DateTime?
  formaPagamento String?
  observacoes    String?
  createdAt      DateTime   @default(now())

  @@unique([campeonatoId, alunoId])
}

model TransacaoMaquina {
  id            Int        @id @default(autoincrement())
  dataTransacao DateTime
  valor         Float
  parcelas      Int        @default(1)
  bandeira      String     @default("") // Visa, Mastercard, Elo
  tipo          String     @default("credito") // credito, debito
  nomeNoCartao  String     @default("") // nome do portador
  parcela       String? // "1/3", "2/3"... raw do CSV
  autorizacao   String? // codigo de autorizacao
  nsu           String? // NSU da transacao
  custoTaxa     Float? // taxa descontada
  valorLiquido  Float? // valor a receber
  previsao      DateTime? // data prevista para recebimento
  arquivo       String     @default("") // nome do CSV importado
  status        String     @default("pendente") // pendente, reconciliado, ignorado
  alunoId       Int?
  aluno         Aluno?     @relation(fields: [alunoId], references: [id])
  pagamentoId   Int?
  pagamento     Pagamento? @relation(fields: [pagamentoId], references: [id])
  createdAt     DateTime   @default(now())

  @@index([status])
  @@index([dataTransacao])
}

model Configuracao {
  chave String @id
  valor String
}

model WhatsAppMensagem {
  id         Int      @id @default(autoincrement())
  alunoId    Int?
  aluno      Aluno?   @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  telefone   String
  mensagem   String
  tipo       String   @default("text") // text, template, image, document
  direcao    String   @default("outgoing") // outgoing, incoming
  status     String   @default("sent") // sent, delivered, read, failed, received
  instancia  String   @default("escolinha")
  origem     String   @default("manual") // manual, cobranca, comunicado, ai-router, webhook, aniversario
  intent     String? // classificacao AI: cobranca, frequencia, etc
  confidence Float? // confianca da classificacao AI
  messageId  String? // ID da mensagem no WhatsApp
  lida       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([alunoId])
  @@index([messageId])
  @@index([createdAt])
  @@index([origem, direcao])
}

model ChatSession {
  id            Int          @id @default(autoincrement())
  telefone      String       @unique
  responsavelId Int?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  identificado  Boolean      @default(false)
  bloqueado     Boolean      @default(false)
  historico     String       @default("[]")
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Media {
  id           Int         @id @default(autoincrement())
  tipo         String // "video" | "fotos"
  titulo       String
  url          String
  partidaId    Int?
  partida      Partida?    @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  campeonatoId Int?
  campeonato   Campeonato? @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([partidaId])
  @@index([campeonatoId])
}

model Solicitacao {
  id            Int         @id @default(autoincrement())
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  tipo          String // "uniforme", "horario", "documento", "outro"
  descricao     String
  status        String      @default("pendente") // pendente, em_andamento, resolvida, recusada
  resposta      String?
  prazo         DateTime?   // SLA deadline definido pelo admin
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([responsavelId])
  @@index([status])
  @@index([createdAt])
}

model PreMatricula {
  id              Int      @id @default(autoincrement())
  nomeAluno       String
  dataNascimento  DateTime
  turma           String
  horario         String
  nomeResponsavel String
  telefone        String
  email           String
  documentos      String? // JSON array of file paths
  observacoes     String?
  status          String   @default("pendente") // pendente, aprovada, recusada
  consentimentoEm DateTime?
  consentimentoVersao String?
  decididoEm      DateTime?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([decididoEm])
}

model Produto {
  id        Int                @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Float              @default(0)
  categoria String             @default("uniforme") // uniforme, acessorio, outro
  tamanhos  String?            // "P,M,G,GG" ou "Único"
  estoque   Int                @default(0)
  ativo     Boolean            @default(true)
  imagem    String?            // URL da imagem
  movimentos MovimentoEstoque[]
  createdAt DateTime           @default(now())

  @@index([ativo])
  @@index([createdAt])
}

model MovimentoEstoque {
  id        Int      @id @default(autoincrement())
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo      String   // "entrada" | "saida"
  quantidade Int
  motivo    String?
  createdAt DateTime @default(now())

  @@index([produtoId])
}

model Avaliacao {
  id                Int      @id @default(autoincrement())
  alunoId           Int
  aluno             Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  periodo           String // "2026-1S", "2026-2S" (semestre)
  notaTecnica       Float? // 0-10
  notaFisica        Float? // 0-10
  notaComportamento Float? // 0-10
  frequencia        Float? // % presença no período
  observacoes       String?
  createdAt         DateTime @default(now())

  @@unique([alunoId, periodo])
  @@index([alunoId])
}

model DisponibilidadePartida {
  id            Int         @id @default(autoincrement())
  partidaId     Int
  partida       Partida     @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  alunoId       Int
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  resposta      String      // disponivel | indisponivel
  motivo        String?
  respondidoEm  DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([partidaId, alunoId])
  @@index([partidaId, resposta])
  @@index([responsavelId])
}

model DisponibilidadeEvento {
  id            Int         @id @default(autoincrement())
  eventoId      Int
  evento        Evento      @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  alunoId       Int
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  resposta      String      // disponivel | indisponivel
  motivo        String?
  respondidoEm  DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([eventoId, alunoId])
  @@index([eventoId, resposta])
  @@index([responsavelId])
}

model ObjetivoCompartilhado {
  id              Int      @id @default(autoincrement())
  alunoId         Int
  aluno           Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  titulo          String
  descricao       String
  prazo           DateTime?
  status          String   @default("proposto") // proposto | combinado | revisao_solicitada | concluido | cancelado
  respostaFamilia String?
  confirmadoEm    DateTime?
  encerradoEm     DateTime?
  criadoPor       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([alunoId, status])
  @@index([prazo])
}

model DocumentoInstitucional {
  id        Int      @id @default(autoincrement())
  titulo    String
  categoria String
  ativo     Boolean  @default(true)
  criadoPor String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versoes   DocumentoVersao[]

  @@index([ativo, categoria])
}

model DocumentoVersao {
  id          Int      @id @default(autoincrement())
  documentoId Int
  documento   DocumentoInstitucional @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  versao      String
  conteudo    String
  url         String?
  turmas      String   @default("Todas")
  obrigatorio Boolean  @default(true)
  publicadoEm DateTime @default(now())
  criadoPor   String
  createdAt   DateTime @default(now())
  aceites     DocumentoAceite[]

  @@unique([documentoId, versao])
  @@index([documentoId, publicadoEm])
}

model DocumentoAceite {
  id            Int         @id @default(autoincrement())
  versaoId      Int
  versao        DocumentoVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  alunoId       Int
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  declaracao    String
  aceitoEm      DateTime     @default(now())

  @@unique([versaoId, responsavelId, alunoId])
  @@index([responsavelId, aceitoEm])
  @@index([alunoId])
}

model RotinaOperacional {
  id              Int      @id @default(autoincrement())
  titulo          String
  categoria       String
  frequencia      String   // diaria | semanal | mensal
  diaSemana       Int?
  diaMes          Int?
  responsavelId   Int?
  responsavel     Usuario? @relation("ResponsavelRotinaOperacional", fields: [responsavelId], references: [id], onDelete: SetNull)
  ativa           Boolean  @default(true)
  criadaPor       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ocorrencias     RotinaOcorrencia[]

  @@index([ativa, frequencia])
  @@index([responsavelId])
}

model RotinaOcorrencia {
  id            Int      @id @default(autoincrement())
  rotinaId      Int
  rotina        RotinaOperacional @relation(fields: [rotinaId], references: [id], onDelete: Cascade)
  referencia    String
  vencimento    DateTime
  status        String   @default("pendente") // pendente | concluida | ignorada
  concluidaPorId Int?
  concluidaPor  Usuario? @relation("ConclusaoRotinaOperacional", fields: [concluidaPorId], references: [id], onDelete: SetNull)
  observacao    String?
  concluidaEm   DateTime?
  createdAt     DateTime @default(now())

  @@unique([rotinaId, referencia])
  @@index([status, vencimento])
  @@index([concluidaPorId])
}

model ConfiguracaoTurma {
  id         Int      @id @default(autoincrement())
  nome       String   @unique
  capacidade Int
  ativa      Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  listaEspera ListaEsperaTurma[]

  @@index([ativa, nome])
}

model ListaEsperaTurma {
  id          Int      @id @default(autoincrement())
  turmaId     Int
  turma       ConfiguracaoTurma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  nomeAluno   String
  responsavel String
  telefone    String
  email       String?
  status      String   @default("aguardando") // aguardando | contatado | matriculado | desistiu
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([turmaId, status, createdAt])
}

model FichaMedicaLeitura {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  versao    Int
  lidaEm    DateTime @default(now())

  @@unique([alunoId, usuarioId, versao])
  @@index([usuarioId, lidaEm])
}

model ConversaFamilia {
  id           Int      @id @default(autoincrement())
  alunoId      Int
  aluno        Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  titulo       String
  contextoTipo String   // geral | objetivo | documento | convocacao | solicitacao
  contextoId   Int?
  status       String   @default("aberta") // aberta | encerrada
  criadaPor    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  mensagens    MensagemConversaFamilia[]

  @@index([alunoId, status, updatedAt])
  @@index([contextoTipo, contextoId])
}

model MensagemConversaFamilia {
  id                Int      @id @default(autoincrement())
  conversaId        Int
  conversa          ConversaFamilia @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autorTipo         String   // equipe | familia
  autorIdentificador String
  texto             String
  createdAt         DateTime @default(now())

  @@index([conversaId, id])
}

model RegraAutomacao {
  id              Int      @id @default(autoincrement())
  titulo          String
  tipo            String   // documento_pendente | mensalidade_vencida | renovacao_pendente | objetivo_vencendo
  antecedenciaDias Int      @default(0)
  responsavelId   Int
  responsavel     Usuario  @relation("ResponsavelRegraAutomacao", fields: [responsavelId], references: [id], onDelete: Cascade)
  ativa           Boolean  @default(true)
  criadaPor       String
  ultimaExecucaoEm DateTime?
  createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    execucoes       ExecucaoAutomacao[]
    ciclos          CicloAutomacao[]

  @@index([ativa, tipo])
  @@index([responsavelId])
}

  model ExecucaoAutomacao {
  id         Int      @id @default(autoincrement())
  regraId    Int
  regra      RegraAutomacao @relation(fields: [regraId], references: [id], onDelete: Cascade)
  referencia String
  titulo     String
  href       String
  createdAt  DateTime @default(now())

  @@unique([regraId, referencia])
  @@index([regraId, createdAt])
  }

  model CicloAutomacao {
    id         Int      @id @default(autoincrement())
    regraId    Int
    regra      RegraAutomacao @relation(fields: [regraId], references: [id], onDelete: Cascade)
    status     String   // sucesso | erro
    encontrados Int    @default(0)
    criados    Int     @default(0)
    erro       String?
    iniciadoEm DateTime @default(now())
    finalizadoEm DateTime?

    @@index([regraId, iniciadoEm])
    @@index([status, iniciadoEm])
  }

  model TratamentoPendencia {
    id          Int      @id @default(autoincrement())
    chave       String   @unique
    status      String   @default("aberta") // aberta | resolvida | adiada
    responsavel String?
    adiadaAte   DateTime?
    observacao  String?
    alteradaPor String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([status, adiadaAte])
    @@index([responsavel, status])
  }

model AcaoDesenvolvimento {
  id          Int      @id @default(autoincrement())
  alunoId     Int
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  insightKey  String   @unique
  tipo        String
  titulo      String
  acao        String
  status      String   @default("pendente") // pendente, concluida, ignorada
  observacao  String?
  usuario     String?
  planoSemanal       String?
  mensagemFamilia    String?
  rascunhoFonte      String?
  rascunhoAprovadoEm DateTime?
  responsavelId Int?
  responsavel Usuario? @relation("ResponsavelAcaoDesenvolvimento", fields: [responsavelId], references: [id], onDelete: SetNull)
  prazo String?
  prioridade String @default("media") // alta, media, baixa
  andamento String @default("planejada") // planejada, em_andamento, impedida, concluida
  impedimento String?
  planoTreinoId Int?
  planoTreino PlanoTreino? @relation(fields: [planoTreinoId], references: [id], onDelete: SetNull)
  comentarios AcaoDesenvolvimentoComentario[]
  historico AcaoDesenvolvimentoHistorico[]
  notificacoes NotificacaoInterna[]
  sessoesTreino SessaoTreinoAcao[]
  concluidaEm DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([alunoId, status])
  @@index([status, updatedAt])
  @@index([responsavelId, status, prazo])
  @@index([planoTreinoId])
}

model AcaoDesenvolvimentoComentario {
  id Int @id @default(autoincrement())
  acaoId Int
  acao AcaoDesenvolvimento @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  usuario String
  texto String
  createdAt DateTime @default(now())

  @@index([acaoId, id])
}

model AcaoDesenvolvimentoHistorico {
  id Int @id @default(autoincrement())
  acaoId Int
  acao AcaoDesenvolvimento @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  usuario String
  alteracoes String
  createdAt DateTime @default(now())

  @@index([acaoId, id])
}

model ResumoFamiliar {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  mes       String
  texto     String
  usuario   String
  chave     String   @unique
  publicacao PublicacaoResumo?
  createdAt DateTime @default(now())

  @@index([alunoId, id])
}

model PautaSemanal {
  id          Int      @id @default(autoincrement())
  turma       String
  cicloInicio String
  texto       String
  usuario     String
  chave       String   @unique
  createdAt   DateTime @default(now())

  @@index([turma, id])
}

model PlanoTreino {
  id Int @id @default(autoincrement())
  turma String
  preferencias String
  texto String
  usuario String
  chave String @unique
  createdAt DateTime @default(now())
  retornos RetornoPlanoTreino[]
  acoesDesenvolvimento AcaoDesenvolvimento[]
  sessoesTreino SessaoTreino[]

  @@index([turma, id])
}

model AtividadeTreino {
  id Int @id @default(autoincrement())
  titulo String
  descricao String
  objetivo String
  faixa String
  duracaoMin Int
  materiais String
  tags String
  ativa Boolean @default(true)
  versaoAtual Int @default(1)
  arquivadaEm DateTime?
  arquivadaPor String?
  validadaEm DateTime?
  validadaPor String?
  criadaPor String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favoritos AtividadeTreinoFavorito[]
  usos SessaoTreinoAtividade[]
  versoes AtividadeTreinoVersao[]

  @@index([ativa, objetivo, faixa])
}

model AtividadeTreinoVersao {
  id Int @id @default(autoincrement())
  atividadeId Int
  atividade AtividadeTreino @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  numero Int
  titulo String
  descricao String
  objetivo String
  faixa String
  duracaoMin Int
  materiais String
  tags String
  validadaEm DateTime?
  validadaPor String?
  criadaPor String
  createdAt DateTime @default(now())
  usos SessaoTreinoAtividade[]

  @@unique([atividadeId, numero])
  @@index([atividadeId, id])
}

model AtividadeTreinoFavorito {
  atividadeId Int
  atividade AtividadeTreino @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([atividadeId, usuarioId])
  @@index([usuarioId])
}

model SessaoTreino {
  id Int @id @default(autoincrement())
  turma String
  realizadoEm String
  duracaoMin Int
  planoTreinoId Int?
  planoTreino PlanoTreino? @relation(fields: [planoTreinoId], references: [id], onDelete: SetNull)
  resumo String
  adaptacoes String?
  ocorrencias String?
  usuario String
  createdAt DateTime @default(now())
  atletas SessaoTreinoAtleta[]
  acoes SessaoTreinoAcao[]
  atividades SessaoTreinoAtividade[]

  @@index([turma, realizadoEm, id])
  @@index([planoTreinoId])
}

model SessaoTreinoAtleta {
  sessaoId Int
  sessao SessaoTreino @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  alunoId Int
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@id([sessaoId, alunoId])
  @@index([alunoId])
}

model SessaoTreinoAcao {
  sessaoId Int
  sessao SessaoTreino @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  acaoId Int
  acao AcaoDesenvolvimento @relation(fields: [acaoId], references: [id], onDelete: Cascade)

  @@id([sessaoId, acaoId])
  @@index([acaoId])
}

model SessaoTreinoAtividade {
  sessaoId Int
  sessao SessaoTreino @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  atividadeId Int
  atividade AtividadeTreino @relation(fields: [atividadeId], references: [id], onDelete: Restrict)
  atividadeVersaoId Int?
  atividadeVersao AtividadeTreinoVersao? @relation(fields: [atividadeVersaoId], references: [id], onDelete: SetNull)
  resultado String // planejada, adaptada, nao_utilizada
  observacao String?

  @@id([sessaoId, atividadeId])
  @@index([atividadeId, resultado])
  @@index([atividadeVersaoId])
}

model NotificacaoInterna {
  id Int @id @default(autoincrement())
  destinatarioId Int
  destinatario Usuario @relation(fields: [destinatarioId], references: [id], onDelete: Cascade)
  acaoId Int?
  acao AcaoDesenvolvimento? @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  tipo String
  titulo String
  href String
  lidaEm DateTime?
  createdAt DateTime @default(now())

  @@index([destinatarioId, lidaEm, id])
  @@index([acaoId])
}

model RetornoPlanoTreino {
  id Int @id @default(autoincrement())
  planoId Int
  plano PlanoTreino @relation(fields: [planoId], references: [id], onDelete: Cascade)
  aplicadoEm String
  resultado String
  observacao String
  usuario String
  chave String @unique
  createdAt DateTime @default(now())

  @@index([planoId, id])
}

model PublicacaoResumo {
  id Int @id @default(autoincrement())
  resumoId Int @unique
  resumo ResumoFamiliar @relation(fields: [resumoId], references: [id], onDelete: Cascade)
  responsavelId Int
  responsavel Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  publicadoPor String
  publicadoEm DateTime @default(now())
  retiradoEm DateTime?
  lidoEm DateTime?

  @@index([responsavelId, id])
}

model Recebimento {
  id             Int      @id @default(autoincrement())
  data           DateTime
  descricao      String
  categoria      String // "Uniforme", "Evento", "Doação", "Outros"
  valor          Float
  formaPagamento String // "Dinheiro", "PIX", "Transferência", "Cartão"
  observacoes    String?
  createdAt      DateTime @default(now())

  @@index([data])
}

model LancamentoBancario {
  id        Int      @id @default(autoincrement())
  data      DateTime
  descricao String
  valor     Float    // positivo = entrada, negativo = saída
  tipo      String   // "entrada" | "saida"
  saldo     Float?   // saldo após o lançamento (se disponível no extrato)
  banco     String?  // nome/identificador do banco
  arquivo   String   // nome do arquivo importado
  status    String   @default("novo") // "novo" | "reconciliado" | "ignorado"
  categoria String?  // "mensalidade" | "custo_operacional" | "transferencia" | "imposto" | "outro"
  createdAt DateTime @default(now())

  @@index([data])
  @@index([tipo])
  @@index([status])
}

model EscalacaoJogador {
  id        Int      @id @default(autoincrement())
  partidaId Int
  partida   Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  alunoId   Int
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  posicao      String // GOLEIRO, FIXO, ALA_ESQ, ALA_DIR, PIVO, BANCO
  numero       Int?
  ordem        Int      @default(0)
  convocadoEm  DateTime?
  confirmacao  String? // "confirmado" | "ausente" | null (sem resposta)
  respondidoEm DateTime?
  createdAt    DateTime @default(now())

  @@unique([partidaId, alunoId])
  @@index([partidaId])
}

model PushSubscription {
  id            Int         @id @default(autoincrement())
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  endpoint      String      @unique
  p256dh        String
  auth          String
  createdAt     DateTime    @default(now())

  @@index([responsavelId])
}

model NotificacaoPreferencia {
  responsavelId       Int         @id
  responsavel         Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  vencimento          Boolean     @default(true)
  pagamentoConfirmado Boolean     @default(true)
  falta               Boolean     @default(false)
  convocacao          Boolean     @default(true)
  comunicado          Boolean     @default(true)
  avaliacao           Boolean     @default(true)
}

model RenovacaoMatricula {
  id            Int         @id @default(autoincrement())
  alunoId       Int
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  periodo       String      // "2026-2S"
  status        String      @default("pendente") // pendente, aprovada, recusada
  observacoes   String?
  resposta      String?
  createdAt     DateTime    @default(now())

  @@unique([alunoId, periodo])
  @@index([responsavelId])
}

model Noticia {
  id         Int      @id @default(autoincrement())
  titulo     String
  subtitulo  String?
  categoria  String   @default("Notícia")
  imagemUrl  String?
  publicado  Boolean  @default(false)
  destaque   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([publicado])
  @@index([createdAt])
}
