generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id             Int          @id @default(autoincrement())
  nome           String
  dataNascimento DateTime
  turma          String
  horario        String
  responsavel    String
  telefone       String
  email          String
  dataMatricula  DateTime
  mensalidade    Float
  desconto       Float        @default(0)
  foto           String?
  status         String       @default("Ativo")
  observacoes    String?
  pagamentos     Pagamento[]
  frequencias    Frequencia[]
  uniformes      Uniforme[]
  whatsapp       WhatsAppMensagem[]
  transacoes     TransacaoMaquina[]
  inscricoes     InscricaoCampeonato[]
  responsavelId  Int?
  responsavelRef Responsavel?  @relation(fields: [responsavelId], references: [id])
  avaliacoes     Avaliacao[]
  createdAt      DateTime     @default(now())
}

model Pagamento {
  id             Int               @id @default(autoincrement())
  alunoId        Int
  aluno          Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  mesReferencia  String
  dataVencimento DateTime
  dataPagamento  DateTime?
  formaPagamento String?
  valorRecebido  Float?
  observacoes    String?
  transacoes     TransacaoMaquina[]
  createdAt      DateTime          @default(now())
}

model Custo {
  id             Int      @id @default(autoincrement())
  data           DateTime
  categoria      String
  descricao      String
  fornecedor     String
  valor          Float
  formaPagamento String
  comprovante    Boolean  @default(false)
  observacoes    String?
  createdAt      DateTime @default(now())
}

model CustoRecorrente {
  id             Int      @id @default(autoincrement())
  categoria      String
  descricao      String
  fornecedor     String
  valor          Float
  formaPagamento String
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Frequencia {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  data      DateTime
  presenca  String

  @@unique([alunoId, data])
}

model Uniforme {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  item      String
  tamanho   String?
  entregue  Boolean  @default(false)
  dataEntrega DateTime?
  observacoes String?
  createdAt DateTime @default(now())
}

model Log {
  id        Int       @id @default(autoincrement())
  tipo      String
  descricao String
  usuario   String?
  meta      String?
  createdAt DateTime  @default(now())
}

model Responsavel {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  telefone     String
  senha        String
  cpf          String?       @unique
  ativo        Boolean       @default(true)
  alunos       Aluno[]
  chatSessions ChatSession[]
  resetTokens  ResetToken[]
  createdAt    DateTime      @default(now())
}

model ResetToken {
  id            Int         @id @default(autoincrement())
  token         String      @unique
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id])
  usado         Boolean     @default(false)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

model Evento {
  id         Int      @id @default(autoincrement())
  titulo     String
  tipo       String   // Treino, Jogo, Evento, Reunião
  data       DateTime
  horaInicio String?
  horaFim    String?
  local      String?
  turmas     String?  // "Todas" ou turmas separadas por vírgula
  descricao  String?
  status     String   @default("pendente") // pendente, confirmado, cancelado, realizado
  createdAt  DateTime @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  nome      String
  senha     String
  role      String   @default("secretaria") // admin, secretaria, tecnico
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Recibo {
  id             Int      @id @default(autoincrement())
  numero         String   @unique
  alunoNome      String
  responsavel    String
  mesReferencia  String
  valor          Float
  formaPagamento String
  dataPagamento  DateTime
  createdAt      DateTime @default(now())
}

model Campeonato {
  id            Int                  @id @default(autoincrement())
  nome          String
  descricao     String?
  dataInicio    DateTime
  dataFim       DateTime?
  local         String?
  taxaInscricao Float                @default(0)
  taxaJogo      Float                @default(0)      // taxa por jogo/rodada
  taxaArbitragem Float               @default(0)
  custoTransporte Float              @default(0)
  custoUniforme  Float               @default(0)
  observacoes   String?
  status        String               @default("aberto") // aberto, andamento, encerrado
  inscricoes    InscricaoCampeonato[]
  partidas      Partida[]
  media         Media[]
  createdAt     DateTime             @default(now())
}

model Partida {
  id            Int        @id @default(autoincrement())
  campeonatoId  Int
  campeonato    Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  rodada        Int        @default(1)
  data          DateTime
  adversario    String
  local         String     @default("Casa")  // Casa, Fora, Neutro
  golsPro       Int?
  golsContra    Int?
  resultado     String?    // Vitoria, Derrota, Empate — null se não realizada
  observacoes   String?
  media         Media[]
  createdAt     DateTime   @default(now())
}

model InscricaoCampeonato {
  id             Int        @id @default(autoincrement())
  campeonatoId   Int
  campeonato     Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  alunoId        Int
  aluno          Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  bolsa          Boolean    @default(false)            // bolsa integral (isento)
  desconto       Float      @default(0)                // desconto em R$ sobre a taxa total
  taxaPaga       Boolean    @default(false)
  valorPago      Float?                                // valor efetivamente pago
  dataPagamento  DateTime?
  formaPagamento String?
  observacoes    String?
  createdAt      DateTime   @default(now())

  @@unique([campeonatoId, alunoId])
}

model TransacaoMaquina {
  id             Int       @id @default(autoincrement())
  dataTransacao  DateTime
  valor          Float
  parcelas       Int       @default(1)
  bandeira       String    @default("")          // Visa, Mastercard, Elo
  tipo           String    @default("credito")    // credito, debito
  nomeNoCartao   String    @default("")           // nome do portador
  parcela        String?                           // "1/3", "2/3"... raw do CSV
  autorizacao    String?                           // codigo de autorizacao
  nsu            String?                           // NSU da transacao
  custoTaxa      Float?                            // taxa descontada
  valorLiquido   Float?                            // valor a receber
  previsao       DateTime?                         // data prevista para recebimento
  arquivo        String    @default("")            // nome do CSV importado
  status         String    @default("pendente")    // pendente, reconciliado, ignorado
  alunoId        Int?
  aluno          Aluno?     @relation(fields: [alunoId], references: [id])
  pagamentoId    Int?
  pagamento      Pagamento? @relation(fields: [pagamentoId], references: [id])
  createdAt      DateTime   @default(now())
}

model Configuracao {
  chave String @id
  valor String
}

model WhatsAppMensagem {
  id         Int      @id @default(autoincrement())
  alunoId    Int?
  aluno      Aluno?   @relation(fields: [alunoId], references: [id])
  telefone   String
  mensagem   String
  tipo       String   @default("text")        // text, template, image, document
  direcao    String   @default("outgoing")    // outgoing, incoming
  status     String   @default("sent")        // sent, delivered, read, failed, received
  instancia  String   @default("escolinha")
  origem     String   @default("manual")      // manual, cobranca, comunicado, ai-router, webhook
  intent     String?                           // classificacao AI: cobranca, frequencia, etc
  confidence Float?                            // confianca da classificacao AI
  messageId  String?                           // ID da mensagem no WhatsApp
  lida       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ChatSession {
  id            Int          @id @default(autoincrement())
  telefone      String       @unique
  responsavelId Int?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id])
  identificado  Boolean      @default(false)
  bloqueado     Boolean      @default(false)
  historico     String       @default("[]")
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Media {
  id           Int         @id @default(autoincrement())
  tipo         String      // "video" | "fotos"
  titulo       String
  url          String
  partidaId    Int?
  partida      Partida?    @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  campeonatoId Int?
  campeonato   Campeonato? @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?
  preco      Float    @default(0)
  categoria  String   @default("uniforme") // uniforme, acessorio, outro
  tamanhos   String?  // "P,M,G,GG" ou "Único"
  estoque    Int      @default(0)
  ativo      Boolean  @default(true)
  imagem     String?  // URL da imagem
  createdAt  DateTime @default(now())
}

model Avaliacao {
  id                Int      @id @default(autoincrement())
  alunoId           Int
  aluno             Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  periodo           String   // "2026-1S", "2026-2S" (semestre)
  notaTecnica       Float?   // 0-10
  notaFisica        Float?   // 0-10
  notaComportamento Float?   // 0-10
  frequencia        Float?   // % presença no período
  observacoes       String?
  createdAt         DateTime @default(now())

  @@unique([alunoId, periodo])
}
