# Troque pelo domínio real quando existir (Caddy emite HTTPS sozinho).
# Sem domínio ainda: use ":80" para servir por IP, sem HTTPS.
:80 {
	encode zstd gzip
	header -Server
	reverse_proxy localhost:3000
}

