# Template de DESENVOLVIMENTO — copie para .env e ajuste.
# Para produção (VPS), use .env.production.example + deploy/gen-secrets.sh
# (checklist em deploy/README.md).

# Credenciais de acesso ao painel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-para-uma-senha-segura

# Banco de dados SQLite (caminho relativo ao repo)
DATABASE_URL=file:./prisma/dev.db

# Chave secreta para assinar cookies de sessão (obrigatória em produção)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=mude-esta-chave-para-algo-seguro-em-producao

# Token para /api/cron/lembretes (obrigatório em produção)
CRON_SECRET=mude-esta-chave-cron

# Configuração da Evolution API (EVOLUTION_API_KEY obrigatória em produção)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=escolinha

# Configuração de e-mail (opcional — lembretes de inadimplência)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Ambiente (next dev/start já definem; só sobrescreva se souber por quê)
NODE_ENV=development

# URL pública do app (usada em links de email — recuperação de senha, etc)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modelo Claude para o chatbot WhatsApp (opcional — padrão: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-6

# Token para sincronização da FPFS (POST /api/sync/fpfs)
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# FPFS_SYNC_TOKEN=seu-token-fpfs-aqui

# Chave da API Anthropic para o chatbot
# ANTHROPIC_API_KEY=sua-chave-aqui

# Copiloto: local por padrão, sem consumo de API, mesmo com chave configurada.
# Só ative após decidir usar a integração externa (pode gerar custos).
DESENVOLVIMENTO_AI_ENABLED=false
# Modelo externo do copiloto (usado apenas quando habilitado — herda CLAUDE_MODEL)
# DESENVOLVIMENTO_AI_MODEL=claude-sonnet-5

# Google Calendar API (Service Account — opcional)
# 1. Crie uma service account em https://console.cloud.google.com/apis/credentials
# 2. Ative a Google Calendar API
# 3. Baixe a chave JSON e copie o client_email e private_key
# 4. Compartilhe seu calendário com o client_email (permissão "Fazer alterações nos eventos")
# 5. Preencha abaixo:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=escolinha@seu-projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Mercado Pago (PIX + Boleto)
# Use o token TEST-... em desenvolvimento; troque pelo APP_USR-... só após
# concluir a homologação da aplicação no painel do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-token-aqui
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret-aqui

# Endereço usado como pagador no boleto registrado (o MP exige endereço completo).
# Fallback enquanto o cadastro não coletar endereço por responsável.
ESCOLA_CEP=01310100
ESCOLA_LOGRADOURO=Avenida Paulista
ESCOLA_NUMERO=1000
ESCOLA_BAIRRO=Bela Vista
ESCOLA_CIDADE=São Paulo
ESCOLA_UF=SP

# Push Notifications PWA
# Gere com: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k))"
# VAPID_PUBLIC_KEY e NEXT_PUBLIC_VAPID_PUBLIC_KEY devem ter o mesmo valor.
VAPID_PUBLIC_KEY=sua-chave-publica-vapid-aqui
VAPID_PRIVATE_KEY=sua-chave-privada-vapid-aqui
VAPID_EMAIL=mailto:admin@escolinha.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica-vapid-aqui
